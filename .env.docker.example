# ==========================================
# Easy Fashion Production Docker Setup (.env)
# Copy to .env on your VPS before running docker compose up -d
# ==========================================

# PostgreSQL Credentials
POSTGRES_USER=easy_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_SECURE_PASSWORD
POSTGRES_DB=easy_fashion_prod_db

# Domains (required)
CORS_ORIGIN=https://easy.elevateapparel.com.bd
FRONTEND_URL=https://easy.elevateapparel.com.bd
BACKEND_URL=https://easyapi.elevateapparel.com.bd
NEXT_PUBLIC_API_BASE_URL=https://easyapi.elevateapparel.com.bd/api/v1

# Authentication Secrets (Generate using: openssl rand -base64 48)
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_ACCESS_SECRET_KEY_MIN_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_REFRESH_SECRET_KEY_MIN_32_CHARS

# Super Admin Initial Credentials
SUPER_ADMIN_EMAIL=admin@elevateapparel.com.bd
SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_SUPERADMIN_PASSWORD_MIN_12_CHARS
SUPER_ADMIN_FULL_NAME="System Super Admin"
