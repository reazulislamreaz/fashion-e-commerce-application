# ==========================================
# Easy Fashion NestJS Backend Production Config
# Save as: backend/.env on your VPS
# Domain: https://easyapi.elevateapparel.com.bd
# ==========================================

# Core Application Setup
NODE_ENV=production
PORT=9978
API_PREFIX=/api/v1
APP_NAME="Easy Fashion API"

# Local PostgreSQL Database (Port 5430)
# Format: postgresql://USER:PASSWORD@127.0.0.1:5430/DATABASE_NAME?schema=public
DATABASE_URL=postgresql://easy_user:STRONG_SECURE_PASSWORD_HERE@127.0.0.1:5430/easy_fashion_prod_db?schema=public

# Production CORS Origins (Allowed frontend domains)
CORS_ORIGIN=https://easy.elevateapparel.com.bd

# Request Limits & Rate Limiting
BODY_LIMIT=10mb
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Authentication Secrets (Generate strong 64+ char random strings in production)
# Example command to generate key: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_RANDOM_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_RANDOM_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Cloudinary Integration (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Seed Super Admin Account Credentials (Required for initial database seed)
SUPER_ADMIN_EMAIL=admin@elevateapparel.com.bd
SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_SUPERADMIN_PASSWORD_MIN_12_CHARS
SUPER_ADMIN_FULL_NAME="System Super Admin"

# Frontend / Backend Application URLs
FRONTEND_URL=https://easy.elevateapparel.com.bd
BACKEND_URL=https://easyapi.elevateapparel.com.bd
