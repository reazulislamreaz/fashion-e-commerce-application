# Core Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME="Easy Fashion API"

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/easy_fashion_db?schema=public&sslmode=disable

# CORS (comma-separated origins for multiple frontends)
CORS_ORIGIN=http://localhost:3001

# Request body size limit
BODY_LIMIT=1mb

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Authentication (required in later phases — placeholders only)
JWT_SECRET=replace_with_secure_secret_min_16_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth (optional — later phases)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
