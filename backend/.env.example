# Core Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME="Easy Fashion API"

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/easy_fashion_db?schema=public&sslmode=disable

# CORS (comma-separated origins for multiple frontends)
CORS_ORIGIN=http://localhost:3001

# Request body size limit
BODY_LIMIT=1mb

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Authentication (Phase 2)
JWT_ACCESS_SECRET=replace_with_secure_access_secret_min_16
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret_min_16
JWT_ACCESS_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# OAuth (optional — later phases)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Phase 1 seed — default Super Admin (required for `pnpm prisma:seed`)
# Do not use these placeholder values in production.
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace_with_secure_password
SUPER_ADMIN_FULL_NAME="System Super Admin"
