# Core Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME="Easy Fashion API"
FRONTEND_URL=https://easy.elevateapparel.com.bd
BACKEND_URL=https://easyapi.elevateapparel.com.bd

# PostgreSQL Database Connection (required — set from your provider / Docker)
# Docker Compose example: postgresql://easy_user:secure_db_password@postgres:5432/easy_fashion_prod_db?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public

# CORS (comma-separated origins for allowed frontends)
CORS_ORIGIN=https://easy.elevateapparel.com.bd

# Request body size & rate limiting
BODY_LIMIT=1mb
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Authentication & Security
JWT_ACCESS_SECRET=replace_with_secure_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Database Seed — Default Super Admin (Required for `pnpm prisma:seed`)
SUPER_ADMIN_EMAIL=admin@elevateapparel.com.bd
SUPER_ADMIN_PASSWORD=superadmin123
SUPER_ADMIN_FULL_NAME="System Super Admin"

# Mailer Service (Optional — Nodemailer Gmail SMTP for email verification & password resets)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Image Uploads (Optional — Cloudinary integration)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OAuth Credentials (Optional — Google / Facebook login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
