# Root Environment Configuration for Docker Compose
# ================================================
# Copy this file to `.env` in the project root if overriding Docker Compose environment variables:
#   cp .env.example .env
#
# Also ensure package-level environment files are copied before running locally:
#   cp backend/.env.example backend/.env
#   cp frontend/.env.example frontend/.env.local

# Database Configuration (Docker Compose)
POSTGRES_USER=easy_user
POSTGRES_PASSWORD=secure_db_password
POSTGRES_DB=easy_fashion_prod_db

# Host Ports mapping (Docker Compose)
POSTGRES_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=3001

# Application URLs (Docker Compose)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# Security & Admin Defaults
JWT_ACCESS_SECRET=replace_with_secure_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret_min_32_chars
SUPER_ADMIN_EMAIL=admin@elevateapparel.com.bd
SUPER_ADMIN_PASSWORD=superadmin123
SUPER_ADMIN_FULL_NAME="System Super Admin"
