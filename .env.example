# Root Environment Configuration for Docker Compose
# ================================================
# Copy this file to `.env` in the project root:
#   cp .env.example .env
#
# Also ensure package-level environment files are copied before running locally:
#   cp backend/.env.example backend/.env
#   cp frontend/.env.example frontend/.env.local

# Database Configuration (Docker Compose)
POSTGRES_USER=easy_user
POSTGRES_PASSWORD=secure_db_password
POSTGRES_DB=easy_fashion_prod_db

# Host Ports mapping (Docker Compose)
POSTGRES_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=3001

# Application URLs (required — no hardcoded defaults in code)
NEXT_PUBLIC_API_BASE_URL=https://easyapi.elevateapparel.com.bd/api/v1
FRONTEND_URL=https://easy.elevateapparel.com.bd
BACKEND_URL=https://easyapi.elevateapparel.com.bd
CORS_ORIGIN=https://easy.elevateapparel.com.bd

# Security & Admin Defaults
JWT_ACCESS_SECRET=replace_with_secure_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret_min_32_chars
SUPER_ADMIN_EMAIL=admin@elevateapparel.com.bd
SUPER_ADMIN_PASSWORD=superadmin123
SUPER_ADMIN_FULL_NAME="System Super Admin"

# Cloudinary (required for /api/v1/upload product images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
